    "editorial-decision-intake": "editorial",
    "editorial-revision-loop": "editorial",
    "pause-resume": "control"
  },
  "start_requirements": {
    "scope-and-eligibility": {"pipeline_any": ["review_protocol", "scope_snapshot"]},
    "search-provenance": {"pipeline_all": ["review_protocol"], "pipeline_any": ["eligibility_protocol", "scope_snapshot"]},
    "corpus-curation": {"any": ["reference_pool", "source_manifest"]},
    "lawful-reading": {"any": ["reference_pool", "curated_corpus", "reading_record"]},
    "evidence-synthesis": {"any": ["reading_record", "material_card", "science_draft", "reference_pool"]},
    "review-synthesis": {"any": ["claim_ledger", "evidence_ledger", "reading_record"]},
    "method-comparison": {"any": ["comparison_matrix", "claim_ledger", "evidence_ledger"]},
    "quantitative-audit": {"any": ["method_comparison_table", "claim_ledger", "science_draft"]},
    "argument-architecture": {"any": ["claim_ledger", "evidence_ledger", "synthesis_blocks"]},
    "science-drafting": {"any": ["argument_blueprint", "paragraph_contracts", "claim_ledger"]},
