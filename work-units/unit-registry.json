  "capability_requirements": {
    "search-provenance": {"phase": "start", "any": ["network", "browser", "academic_database"], "accepted_statuses": ["READY", "DEGRADED"]},
    "lawful-reading": {"phase": "start", "any": ["pdf", "browser"], "accepted_statuses": ["READY", "DEGRADED"]},
    "journal-fit": {"phase": "start", "any": ["network", "browser"], "accepted_statuses": ["READY", "DEGRADED"]}
  },
