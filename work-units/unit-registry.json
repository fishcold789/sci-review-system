  "units": [
    {
      "unit_id": "intake-recover",
      "title_zh": "项目接入与状态恢复",
      "entry_signals": ["已有项目", "继续工作", "不知道做到哪", "检查目录"],
      "outputs": ["intake_snapshot", "project_state", "asset_manifest", "entry_dashboard", "baseline_manuscript"],
      "required_gates": ["mechanics"],
      "next_candidates": ["scope-question", "evidence-synthesis", "argument-architecture", "language-naturalization"]
    },
    {
      "unit_id": "scope-question",
      "title_zh": "研究问题与范围收敛",
      "entry_signals": ["确定题目", "缩小范围", "生成检索式", "找研究空白"],
      "outputs": ["scope_snapshot", "term_ledger", "query_plan", "decision_record"],
      "required_gates": ["science", "human"],
      "next_candidates": ["scope-and-eligibility", "search-provenance", "evidence-synthesis", "argument-architecture"]
    },
    {
      "unit_id": "search-provenance",
      "title_zh": "检索与来源池建立",
      "entry_signals": ["检索文献", "整理 RIS", "合并题录", "核验来源"],
      "outputs": ["search_log", "source_manifest", "metadata_qa", "reference_pool"],
      "required_gates": ["mechanics", "science"],
      "next_candidates": ["corpus-curation", "lawful-reading", "evidence-synthesis"]
    },
    {
      "unit_id": "corpus-curation",
      "title_zh": "语料筛选与分类",
      "entry_signals": ["筛选文献", "去重", "分类", "建立文献库"],
      "outputs": ["screening_table", "curated_corpus", "classification_tree", "inclusion_exclusion_log"],
      "required_gates": ["science", "mechanics"],
      "next_candidates": ["lawful-reading", "benchmark-profile", "evidence-synthesis"]
    },
    {
      "unit_id": "lawful-reading",
      "title_zh": "合法获取与定点精读",
      "entry_signals": ["精读论文", "读某篇文章", "提取页码", "整理精读卡"],
      "outputs": ["reading_record", "material_card", "reading_log", "anchor_update"],
      "required_gates": ["science", "mechanics"],
      "next_candidates": ["evidence-synthesis", "benchmark-profile", "argument-architecture"]
    },
    {
      "unit_id": "benchmark-profile",
      "title_zh": "对标样本与方法学习",
      "entry_signals": ["学习综述写法", "对标期刊", "分析样本", "学习图表结构"],
      "outputs": ["benchmark_profile", "style_profile", "adaptation_risk_log"],
      "required_gates": ["science", "mechanics", "human"],
      "next_candidates": ["argument-architecture", "journal-fit", "language-naturalization"]
    },
    {
      "unit_id": "evidence-synthesis",
      "title_zh": "主张、证据与研究空白",
      "entry_signals": ["建立证据表", "核对数字", "找冲突", "判断研究空白", "审计引用"],
      "outputs": ["claim_ledger", "evidence_ledger", "gap_matrix", "conflict_log", "claim_audit"],
      "required_gates": ["science", "mechanics"],
      "next_candidates": ["review-synthesis", "method-comparison", "argument-architecture", "science-audit", "reviewer-audit"]
    },
    {
      "unit_id": "argument-architecture",
      "title_zh": "论证蓝图与信息链",
      "entry_signals": ["搭建框架", "设计章节", "规划段落", "安排图表"],
      "outputs": ["argument_blueprint", "paragraph_contracts", "evidence_support_matrix", "figure_needs"],
      "required_gates": ["science", "human"],
      "next_candidates": ["science-drafting", "visual-reference-qa"]
    },
    {
      "unit_id": "science-drafting",
      "title_zh": "科学底稿与自检",
      "entry_signals": ["写综述正文", "改某一节", "整合段落", "补科学论证"],
      "outputs": ["science_draft", "paragraph_evidence_map", "draft_self_check", "open_checklist"],
      "required_gates": ["science"],
