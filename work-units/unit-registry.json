      "outputs": ["zh_natural_draft", "en_faithful_draft", "en_natural_draft", "language_ledger"],
      "required_gates": ["science", "language"],
      "next_candidates": ["bilingual-alignment", "visual-reference-qa", "reviewer-audit"]
    },
    {
      "unit_id": "bilingual-alignment",
