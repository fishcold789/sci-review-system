{
  "schema_version": "0.5",
  "contract_defaults": {
    "require_registered_outputs": true,
    "accepted_completion_verdicts": ["PASS", "PASS_WITH_CONDITIONS"],
    "condition_verdict_requires_decision": true,
    "forbid_handoff_before_complete": true,
    "block_science_units_on_open_uncertainty": true,
    "uncertainty_resolution_units": ["lawful-reading", "uncertainty-triage", "human-checkpoint", "pause-resume"],
    "require_gate_evidence": true,
    "require_human_decision_for_human_gate": true,
    "reject_changed_or_missing_artifacts": true,
    "fail_closed_on_not_checked": true,
    "required_gate_evidence_must_include_non_self_asserted_ref": true
  },
  "gate_definitions": {
    "science": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "bind_current_artifact_hash": true},
    "language": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "bind_current_artifact_hash": true},
    "mechanics": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "bind_current_artifact_hash": true},
    "uncertainty": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "bind_current_artifact_hash": true},
    "rights_submission": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "bind_current_artifact_hash": true},
    "human": {"accepted_verdicts": ["PASS", "PASS_WITH_CONDITIONS"], "require_evidence_refs": true, "require_decision_id": true}
  },
  "quality_check_definitions": {
    "project-recoverability": {"gate_kind": "mechanics", "evaluator": "deterministic", "pass_condition": "The active baseline, artifacts, versions, blockers, decisions, and next entry can be recovered without chat memory."},
    "scope-and-method": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "The question, review type, boundaries, eligibility, and permitted reporting claims are mutually consistent and explicit."},
    "source-provenance": {"gate_kind": "mechanics", "evaluator": "deterministic", "pass_condition": "Every used source or lookup has a stable identity, acquisition route, status, and exact available anchor; failed or partial access remains visible."},
    "evidence-traceability": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Every material claim maps to adequate evidence and boundaries, while conflicts, missing anchors, and unsupported strength remain explicit."},
    "cross-study-synthesis": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "The output compares studies on shared dimensions, explains agreement or disagreement, and states the applicability boundary instead of listing papers."},
    "comparison-validity": {"gate_kind": "uncertainty", "evaluator": "independent", "pass_condition": "Methods or numbers are compared only when objects, conditions, metrics, truth definitions, and validation protocols are sufficiently comparable."},
    "argument-coherence": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Each section and paragraph has a distinct job, linked claims and evidence, explicit limitations, and a necessary transition in the overall argument."},
    "scientific-fidelity": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Claims, causal strength, numbers, conditions, equations, citations, and limitations remain supported and internally consistent."},
    "language-fidelity": {"gate_kind": "language", "evaluator": "independent", "pass_condition": "Language changes improve clarity or naturalness without changing facts, responsibility, scope, causality, uncertainty, terminology, numbers, formulas, or citations."},
    "bilingual-fidelity": {"gate_kind": "language", "evaluator": "independent", "pass_condition": "The two language versions preserve the same claims, conditions, stance, terminology, numbers, formulas, citations, and limitations."},
    "visual-citation-integrity": {"gate_kind": "mechanics", "evaluator": "deterministic_and_independent", "pass_condition": "Figures, tables, citations, source anchors, reuse status, rights state, and first in-text references form a complete traceable chain."},
    "venue-and-package-basis": {"gate_kind": "rights_submission", "evaluator": "independent", "pass_condition": "Venue or package requirements are tied to a user-approved basis and current official evidence when venue-specific claims are made."},
    "reviewer-traceability": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Each review issue is specific, evidence-grounded, prioritized, actionable, and linked to a repair or a justified boundary."},
    "editorial-traceability": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Every actual editor or reviewer request maps to a plan, manuscript change or justified non-change, response, evidence, location, and completed re-audits."},
    "uncertainty-resolution": {"gate_kind": "science", "evaluator": "independent", "pass_condition": "Uncertainty is classified, scoped to affected claims and units, assigned a permitted action, and escalated when scientific judgment is required."},
    "decision-provenance": {"gate_kind": "human", "evaluator": "human", "pass_condition": "The named human decision answers the recorded question, cites its basis, and unblocks only the listed claims or units."}
  },
  "unit_quality_checks": {
    "intake-recover": ["project-recoverability"],
    "review-protocol": ["scope-and-method"],
    "scope-question": ["scope-and-method"],
    "scope-and-eligibility": ["scope-and-method"],
    "search-provenance": ["source-provenance"],
    "corpus-curation": ["source-provenance"],
    "lawful-reading": ["source-provenance", "evidence-traceability"],
    "benchmark-profile": ["source-provenance"],
    "evidence-synthesis": ["evidence-traceability"],
    "uncertainty-triage": ["uncertainty-resolution"],
    "human-checkpoint": ["decision-provenance"],
    "review-synthesis": ["cross-study-synthesis"],
    "method-comparison": ["comparison-validity"],
    "quantitative-audit": ["comparison-validity"],
    "argument-architecture": ["argument-coherence"],
    "science-drafting": ["scientific-fidelity"],
    "science-audit": ["scientific-fidelity"],
    "language-naturalization": ["language-fidelity"],
    "bilingual-alignment": ["bilingual-fidelity"],
    "terminology-guard": ["language-fidelity"],
    "visual-reference-qa": ["visual-citation-integrity"],
    "citation-integrity": ["visual-citation-integrity"],
    "journal-fit": ["venue-and-package-basis"],
    "reviewer-audit": ["reviewer-traceability"],
    "submission-package": ["venue-and-package-basis"],
    "editorial-decision-intake": ["editorial-traceability"],
    "editorial-revision-loop": ["editorial-traceability"],
    "pause-resume": ["project-recoverability"]
  },
  "change_impact_rules": {
    "review_protocol": {"affected_units": ["scope-and-eligibility", "search-provenance", "corpus-curation", "evidence-synthesis", "review-synthesis", "argument-architecture", "science-drafting", "science-audit", "reviewer-audit"], "required_gate_kinds": ["science", "mechanics", "human"], "reason": "A protocol change can alter eligibility, retrieval, synthesis, argument scope, and downstream reporting claims."},
    "scope": {"affected_units": ["scope-and-eligibility", "search-provenance", "corpus-curation", "lawful-reading", "evidence-synthesis", "review-synthesis", "method-comparison", "argument-architecture", "science-drafting", "science-audit", "citation-integrity", "reviewer-audit"], "required_gate_kinds": ["science", "mechanics", "uncertainty", "human"], "reason": "A scope change can invalidate the corpus, evidence coverage, comparisons, structure, and conclusions."},
    "source_or_evidence": {"affected_units": ["evidence-synthesis", "review-synthesis", "method-comparison", "quantitative-audit", "argument-architecture", "science-drafting", "science-audit", "citation-integrity", "visual-reference-qa", "reviewer-audit"], "required_gate_kinds": ["science", "mechanics", "uncertainty"], "reason": "Changed evidence can alter support, synthesis, comparisons, prose, citations, and review findings."},
    "claim": {"affected_units": ["argument-architecture", "science-drafting", "science-audit", "language-naturalization", "bilingual-alignment", "terminology-guard", "visual-reference-qa", "citation-integrity", "reviewer-audit", "editorial-revision-loop"], "required_gate_kinds": ["science", "language", "mechanics", "uncertainty"], "reason": "A changed claim propagates to argument structure, all language versions, figures, citations, review, and response records."},
    "number_or_condition": {"affected_units": ["quantitative-audit", "science-audit", "language-naturalization", "bilingual-alignment", "terminology-guard", "visual-reference-qa", "reviewer-audit", "editorial-revision-loop"], "required_gate_kinds": ["science", "language", "mechanics", "uncertainty"], "reason": "A changed value or condition requires comparability, protected-span, cross-language, visual, and response checks."},
    "structure": {"affected_units": ["argument-architecture", "science-drafting", "science-audit", "language-naturalization", "visual-reference-qa", "reviewer-audit"], "required_gate_kinds": ["science", "language", "mechanics"], "reason": "A structural change can alter section jobs, transitions, figure placement, and review coverage."},
    "language": {"affected_units": ["language-naturalization", "bilingual-alignment", "terminology-guard", "citation-integrity", "reviewer-audit"], "required_gate_kinds": ["language", "mechanics", "science"], "reason": "Language changes require meaning, terminology, citation, and residual scientific checks."},
    "citation": {"affected_units": ["citation-integrity", "science-audit", "visual-reference-qa", "submission-package", "editorial-revision-loop"], "required_gate_kinds": ["mechanics", "science", "rights_submission"], "reason": "Citation changes can alter support, numbering, figure provenance, package integrity, and response claims."},
    "figure_or_table": {"affected_units": ["visual-reference-qa", "science-audit", "citation-integrity", "reviewer-audit", "submission-package", "editorial-revision-loop"], "required_gate_kinds": ["mechanics", "science", "rights_submission"], "reason": "Visual changes require source, text-reference, scientific, rights, review, and package checks."},
    "journal_or_package": {"affected_units": ["journal-fit", "language-naturalization", "visual-reference-qa", "citation-integrity", "submission-package"], "required_gate_kinds": ["rights_submission", "language", "mechanics", "human"], "reason": "Venue or package changes can alter style, declarations, files, rights, and official requirement checks."},
    "editorial_response": {"affected_units": ["editorial-revision-loop", "science-audit", "language-naturalization", "bilingual-alignment", "citation-integrity", "visual-reference-qa", "submission-package"], "required_gate_kinds": ["science", "language", "mechanics", "rights_submission", "human"], "reason": "A response change must remain consistent with the revised manuscript, evidence, locations, re-audits, and human approval."}
  },
  "block_transitions": {
    "science": ["science-audit", "uncertainty-triage", "human-checkpoint", "pause-resume"],
    "language": ["language-naturalization", "bilingual-alignment", "human-checkpoint", "pause-resume"],
    "mechanics": ["citation-integrity", "visual-reference-qa", "pause-resume"],
    "uncertainty": ["uncertainty-triage", "human-checkpoint", "pause-resume"],
    "rights_submission": ["visual-reference-qa", "journal-fit", "human-checkpoint", "pause-resume"],
    "human": ["human-checkpoint", "pause-resume"]
  },
  "unit_write_roots": {
    "intake-recover": "control",
    "review-protocol": "scope",
    "scope-question": "scope",
    "scope-and-eligibility": "scope",
    "search-provenance": "sources",
    "corpus-curation": "sources",
    "lawful-reading": "reading",
    "benchmark-profile": "reviews",
    "evidence-synthesis": "evidence",
    "uncertainty-triage": "evidence",
    "human-checkpoint": "control",
    "review-synthesis": "argument",
    "method-comparison": "argument",
    "quantitative-audit": "reviews",
    "argument-architecture": "argument",
    "science-drafting": "drafts",
    "science-audit": "reviews",
    "language-naturalization": "drafts",
    "bilingual-alignment": "reviews",
    "terminology-guard": "reviews",
    "visual-reference-qa": "visuals",
    "citation-integrity": "reviews",
