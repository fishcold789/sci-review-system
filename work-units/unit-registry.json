      "required_gates": ["science", "uncertainty", "mechanics"],
      "next_candidates": ["science-drafting", "language-naturalization", "reviewer-audit"]
    },
    {
      "unit_id": "language-naturalization",
      "title_zh": "中文/英文自然化",
