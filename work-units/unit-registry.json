      "entry_signals": ["双语回查", "中英文对齐", "回译核对", "检查英文是否改意"],
      "outputs": ["bilingual_alignment_report", "material_drift_list", "terminology_alignment", "repair_handoff"],
      "required_gates": ["science", "language", "mechanics"],
      "next_candidates": ["language-naturalization", "visual-reference-qa", "submission-package"]
    },
    {
      "unit_id": "visual-reference-qa",
      "title_zh": "图表、引用与版权闭环",
      "entry_signals": ["做图表", "检查引用", "核对图源", "申请图片权限"],
      "outputs": ["visual_manifest", "panel_ledger", "citation_map", "rights_preflight", "mechanical_report"],
      "required_gates": ["mechanics", "rights_submission"],
      "next_candidates": ["language-naturalization", "reviewer-audit", "submission-package"]
    },
    {
      "unit_id": "journal-fit",
      "title_zh": "期刊适配与写作 profile",
      "entry_signals": ["选期刊", "学习作者指南", "适配目标期刊", "查投稿要求"],
      "outputs": ["journal_profile", "journal_exploration_report", "author_guideline_snapshot", "adaptation_matrix", "risk_log"],
      "required_gates": ["rights_submission", "human"],
      "next_candidates": ["language-naturalization", "submission-package"]
    },
    {
      "unit_id": "reviewer-audit",
      "title_zh": "对抗审稿与返修证据链",
      "entry_signals": ["模拟审稿", "预投稿审稿", "检查漏洞", "对抗评审"],
      "outputs": ["review_report", "issue_action_evidence_map", "revision_plan", "re_review_report"],
      "required_gates": ["science", "language", "mechanics"],
      "next_candidates": ["science-drafting", "language-naturalization", "submission-package"]
    },
    {
      "unit_id": "submission-package",
