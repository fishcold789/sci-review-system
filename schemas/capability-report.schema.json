{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/capability-report.schema.json",
  "title": "Execution Capability Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "run_id",
    "generated_at",
    "environment",
    "overall_status",
    "capabilities",
    "blocking_reasons",
    "degraded_reasons"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^CAP-[0-9]{3,}$"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "minLength": 1 },
    "overall_status": { "enum": ["READY", "DEGRADED", "BLOCKED"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "degraded_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_decision_id": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "overall_status": { "const": "READY" } },
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "if": {
                "properties": { "required": { "const": true } },
                "required": ["required"]
              },
              "then": {
                "properties": {
                  "status": { "const": "READY" },
                  "checks": {
                    "items": {
                      "properties": { "status": { "const": "PASS" } },
                      "required": ["status"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "overall_status": { "const": "DEGRADED" } },
        "required": ["overall_status"]
      },
      "then": {
        "properties": { "degraded_reasons": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "overall_status": { "const": "BLOCKED" } },
        "required": ["overall_status"]
      },
      "then": {
        "properties": { "blocking_reasons": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "category",
        "required",
        "enhancement_only",
        "status",
        "checked_at",
        "checks",
        "available_routes",
        "selected_route",
        "fallback",
        "limitations",
        "dependent_unit_ids"
      ],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "network",
            "browser",
            "academic_database",
            "pdf",
            "docx",
            "reference_manager",
            "consensus",
            "scite",
            "other"
          ]
        },
        "required": { "type": "boolean" },
        "enhancement_only": { "type": "boolean" },
        "status": { "enum": ["READY", "DEGRADED", "BLOCKED"] },
        "checked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        "available_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "native_tool",
              "browser",
              "api",
              "local_application",
              "command_line",
              "user_assisted",
              "manual_equivalent",
              "none",
              "other"
            ]
          }
        },
        "selected_route": { "type": ["string", "null"] },
        "fallback": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["route", "validated", "limitations"],
          "properties": {
            "route": { "type": "string", "minLength": 1 },
            "validated": { "type": "boolean" },
            "limitations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependent_unit_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": { "enum": ["consensus", "scite"] }
            },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "required": { "const": false },
              "enhancement_only": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "READY" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "checked_at": { "type": "string", "format": "date-time" },
              "selected_route": { "type": "string", "minLength": 1 },
              "checks": {
                "contains": {
                  "type": "object",
                  "properties": { "status": { "const": "PASS" } },
                  "required": ["status"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required": { "const": true },
              "status": { "const": "BLOCKED" }
            },
            "required": ["required", "status"]
          },
          "then": {
            "properties": {
              "dependent_unit_ids": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "DEGRADED" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "properties": { "limitations": { "minItems": 1 } }
              },
              {
                "properties": {
                  "fallback": {
                    "type": "object",
                    "properties": { "validated": { "const": true } },
                    "required": ["validated"]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "operation", "status", "observed_at", "method", "evidence_refs", "reason"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "method": { "type": ["string", "null"] },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "PASS" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_at": { "type": "string", "format": "date-time" },
              "method": { "type": "string", "minLength": 1 },
              "evidence_refs": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
