{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/handoff.schema.json",
  "title": "SCI Review Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "from_unit", "to_units", "status", "artifact_ids", "gate_ids", "open_questions", "human_decisions", "created_at", "run_id"],
  "properties": {
    "handoff_id": { "type": "string", "pattern": "^hf--[a-z0-9-]+--[a-z0-9-]+--[0-9]{3,}$" },
    "from_unit": { "type": "string", "minLength": 1 },
    "to_units": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "enum": ["prepared", "escalation", "accepted", "rejected", "superseded"] },
    "artifact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "gate_ids": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "human_decisions": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 }
  }
}
