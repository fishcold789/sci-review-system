{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/gate.schema.json",
  "title": "SCI Review Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "unit_id", "kind", "verdict", "blocking", "advisory", "checks", "evidence", "human_decision_id", "created_at", "run_id"],
  "properties": {
    "gate_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["science", "language", "mechanics", "uncertainty", "rights_submission", "human"] },
    "verdict": { "enum": ["PASS", "PASS_WITH_CONDITIONS", "WARN", "BLOCK", "UNKNOWN"] },
    "blocking": { "type": "boolean" },
    "advisory": { "type": "boolean" },
    "checks": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "human_decision_id": { "type": ["string", "null"] }
  }
}
