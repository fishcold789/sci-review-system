{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/claim-evidence.schema.json",
  "title": "Claim Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim_text", "claim_type", "claim_strength", "scope", "source_refs", "supporting_evidence", "contradicting_evidence", "limitations", "allowed_wording", "human_review_status"],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
    "claim_text": { "type": "string", "minLength": 1 },
    "claim_type": { "enum": ["literature_fact", "cross_literature_synthesis", "author_interpretation", "technical_inference", "unverified_hypothesis", "future_recommendation", "numeric", "limitation", "definition"] },
    "claim_strength": { "enum": ["verified", "supported", "uncertain", "human_review_required"] },
    "scope": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "supporting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "allowed_wording": { "type": "array", "items": { "type": "string" } },
    "human_review_status": { "enum": ["not_required", "pending", "accepted", "rejected", "superseded"] },
    "experimental_conditions": { "type": "object" },
    "uncertainty_ids": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source", "anchor", "relation"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E-[0-9]{3,}$" },
        "source": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["supports", "contradicts", "partial", "insufficient"] },
        "quote_or_paraphrase": { "type": "string" },
        "conditions": { "type": "object" }
      }
    }
  }
}
