{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/project_state.schema.json",
  "title": "SCI Review Project State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_title",
    "project_root",
    "run_id",
    "status",
    "mode",
    "state_version",
    "current_unit_id",
    "project_profile",
    "entry",
    "scope",
    "baseline",
    "units",
    "artifacts",
    "sources",
    "lookups",
    "capabilities",
    "venue",
    "gates",
    "handoffs",
    "review_protocol",
    "uncertainties",
    "human_checkpoints",
    "pause_records",
    "decisions",
    "blockers",
    "policy"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "project_title": { "type": "string", "minLength": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^run-[0-9]{8}-[0-9]{3}$" },
    "status": { "enum": ["initializing", "running", "paused", "awaiting_decision", "completed", "aborted", "blocked"] },
    "mode": { "enum": ["pipeline", "checkpoint", "audit_only", "translation", "revision", "submission"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "state_version": { "type": "integer", "minimum": 1 },
    "current_unit_id": { "type": ["string", "null"] },
    "project_profile": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "profile_version", "path", "selection_reason"],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "profile_version": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "selection_reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "entry": { "$ref": "#/$defs/entry" },
    "scope": { "$ref": "#/$defs/scope" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "units": { "type": "object" },
    "artifacts": { "type": "object" },
    "sources": {
      "type": "object",
      "additionalProperties": { "$ref": "source-record.schema.json" }
    },
    "lookups": {
      "type": "object",
      "additionalProperties": { "$ref": "lookup-record.schema.json" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "journal_name", "decision_id", "set_by", "updated_at"],
      "properties": {
        "status": { "enum": ["not_selected", "candidate", "confirmed"] },
        "journal_name": { "type": ["string", "null"] },
        "decision_id": { "type": ["string", "null"] },
        "set_by": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "gates": { "type": "object" },
    "handoffs": { "type": "object" },
    "review_protocol": { "type": ["object", "null"] },
    "uncertainties": { "type": "object" },
    "human_checkpoints": { "type": "object" },
    "pause_records": { "type": "array", "items": { "type": "object" } },
    "re_audit_plans": {
      "type": "object",
      "additionalProperties": { "$ref": "re-audit-plan.schema.json" }
    },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "object" } },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "entry_kind", "detected_artifact_ids", "assumptions", "user_confirmed"],
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "entry_kind": { "enum": ["topic", "artifact", "checkpoint", "audit", "revision", "translation", "submission"] },
        "detected_artifact_ids": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "user_confirmed": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_question", "in_scope", "out_of_scope", "target_languages", "target_outputs", "scope_version"],
      "properties": {
        "research_question": { "type": ["string", "null"] },
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "target_languages": { "type": "array", "items": { "enum": ["zh", "en", "bilingual"] } },
        "target_outputs": { "type": "array", "items": { "type": "string" } },
        "scope_version": { "type": "string", "pattern": "^v[0-9]{3}$" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_hash", "reading_session_path", "current_anchor", "captured_at"],
      "properties": {
        "manifest_path": { "type": "string" },
        "manifest_hash": { "type": "string" },
        "reading_session_path": { "type": "string" },
        "current_anchor": { "type": ["object", "null"] },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_mode", "allow_parallel_agents", "require_human_at", "allow_auto_scientific_rewrite", "sensitive_material_upload"],
      "properties": {
        "write_mode": { "enum": ["scoped", "read_only"] },
        "allow_parallel_agents": { "type": "boolean" },
        "require_human_at": { "type": "array", "items": { "type": "string" } },
        "allow_auto_scientific_rewrite": { "const": false },
        "sensitive_material_upload": { "enum": ["deny", "ask", "allow_metadata_only"] }
      }
    }
  }
}
