{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/package-plan.schema.json",
  "title": "User-Directed Submission Package Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_plan_id",
    "project_id",
    "status",
    "journal_context",
    "package_bases",
    "items",
    "mappings",
    "conflicts",
    "user_control",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "package_plan_id": { "type": "string", "pattern": "^PP-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "user_confirmed", "assembled", "checked"] },
    "journal_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "venue_profile_id", "compliance_claim_allowed"],
      "properties": {
        "status": { "enum": ["not_selected", "candidate", "confirmed"] },
        "venue_profile_id": { "type": ["string", "null"], "pattern": "^VP-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "compliance_claim_allowed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "venue_profile_id": { "type": "string", "pattern": "^VP-[A-Za-z0-9][A-Za-z0-9._-]*$" }
            }
          },
          "else": {
            "properties": {
              "compliance_claim_allowed": { "const": false }
            }
          }
        }
      ]
    },
    "package_bases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageBasis" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageItem" }
    },
    "mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapping" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "user_control": { "$ref": "#/$defs/userControl" },
    "check_report_path": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["draft", "user_confirmed", "assembled"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "journal_context": {
            "properties": { "compliance_claim_allowed": { "const": false } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "checked" } }, "required": ["status"] },
      "then": {
        "properties": { "check_report_path": { "type": "string", "minLength": 1 } },
        "required": ["check_report_path"]
      }
    },
    {
      "if": {
        "properties": {
          "journal_context": {
            "properties": { "compliance_claim_allowed": { "const": true } },
            "required": ["compliance_claim_allowed"]
          }
        },
        "required": ["journal_context"]
      },
      "then": {
        "properties": {
          "status": { "const": "checked" },
          "journal_context": {
            "properties": { "status": { "const": "confirmed" } }
          },
          "check_report_path": { "type": "string", "minLength": 1 }
        },
        "required": ["check_report_path"]
      }
    },
    {
      "if": {
        "properties": {
          "journal_context": {
            "properties": { "status": { "enum": ["not_selected", "candidate"] } },
            "required": ["status"]
          }
        },
        "required": ["journal_context"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/packageItem" },
                { "properties": { "required_by": { "enum": ["user", "user_template"] } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["user_confirmed", "assembled", "checked"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "package_bases": {
            "contains": {
              "properties": { "confirmed_by_user": { "const": true } },
              "required": ["confirmed_by_user"]
            },
            "minContains": 1
          },
          "user_control": {
            "allOf": [
              { "$ref": "#/$defs/userControl" },
              { "properties": { "shape_confirmed": { "const": true } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "packageBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis_id", "basis_type", "reference", "confirmed_by_user", "captured_at"],
      "properties": {
        "basis_id": { "type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "basis_type": { "enum": ["user_manifest", "user_template", "user_instruction"] },
        "reference": { "type": "string", "minLength": 1 },
        "content_hash": { "type": ["string", "null"] },
        "confirmed_by_user": { "type": "boolean" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "packageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "target_path", "label", "required_by", "basis_ids", "source_artifacts", "operation", "owner", "status"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^PI-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "target_path": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required_by": { "enum": ["user", "user_template", "confirmed_journal"] },
        "basis_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$" } },
        "venue_requirement_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^VR-[A-Za-z0-9][A-Za-z0-9._-]*$" } },
        "source_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "operation": { "enum": ["copy", "rename", "convert", "render", "generate", "check_only", "user_supplies"] },
        "owner": { "enum": ["user", "system", "shared"] },
        "status": { "enum": ["planned", "ready", "missing", "blocked", "not_applicable"] },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "required_by": { "const": "confirmed_journal" } }, "required": ["required_by"] },
          "then": { "properties": { "venue_requirement_ids": { "minItems": 1 } }, "required": ["venue_requirement_ids"] }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "basis_id", "requested_slot", "item_ids", "status"],
      "properties": {
        "mapping_id": { "type": "string", "pattern": "^PM-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "basis_id": { "type": "string", "pattern": "^PB-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "requested_slot": { "type": "string", "minLength": 1 },
        "item_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^PI-[A-Za-z0-9][A-Za-z0-9._-]*$" } },
        "status": { "enum": ["mapped", "unresolved", "not_applicable"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "description", "status", "user_decision"],
      "properties": {
        "conflict_id": { "type": "string", "pattern": "^PC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved"] },
        "user_decision": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "properties": { "user_decision": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "userControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_shape_owner", "shape_confirmed", "submission_actor", "system_may_submit"],
      "properties": {
        "final_shape_owner": { "const": "user" },
        "shape_confirmed": { "type": "boolean" },
        "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "submission_actor": { "const": "user" },
        "system_may_submit": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "shape_confirmed": { "const": true } }, "required": ["shape_confirmed"] },
          "then": { "properties": { "confirmed_at": { "type": "string", "format": "date-time" } } }
        }
      ]
    }
  }
}
