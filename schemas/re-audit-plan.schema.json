{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/re-audit-plan.schema.json",
  "title": "Material Change Re-audit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_unit_id",
    "change_types",
    "changed_artifact_ids",
    "affected_claim_ids",
    "affected_sections",
    "reason",
    "rule_reasons",
    "affected_unit_ids",
    "required_gate_kinds",
    "invalidated_gate_ids",
    "status",
    "created_at",
    "run_id"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "plan_id": { "type": "string", "pattern": "^RAP-[0-9]{3,}$" },
    "source_unit_id": { "type": "string", "minLength": 1 },
    "change_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "review_protocol",
          "scope",
          "source_or_evidence",
          "claim",
          "number_or_condition",
          "structure",
          "language",
          "citation",
          "figure_or_table",
          "journal_or_package",
          "editorial_response"
        ]
      }
    },
    "changed_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "affected_claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "affected_sections": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "reason": { "type": "string", "minLength": 1 },
    "rule_reasons": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "affected_unit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "required_gate_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["science", "language", "mechanics", "uncertainty", "rights_submission", "human"] }
    },
    "invalidated_gate_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "status": { "enum": ["preview", "applied", "resolved", "superseded"] },
    "stale_unit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "resolved_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 }
  }
}
