{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sci-review-system://schemas/lookup-record.schema.json",
  "title": "External Lookup Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lookup_id",
    "unit_id",
    "question",
    "purpose",
    "obligation",
    "planned_capability_id",
    "actual_route",
    "query_or_action",
    "executed_at",
    "status",
    "source_ids",
    "trace_refs",
    "reason"
  ],
  "properties": {
    "lookup_id": {
      "type": "string",
      "pattern": "^LKP-[0-9]{3,}$"
    },
    "unit_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "purpose": {
      "enum": [
        "scientific_claim",
        "numeric_claim",
        "field_synthesis",
        "bibliographic_verification",
        "journal_requirement",
        "submission_requirement",
        "citation_context",
        "capability_probe",
        "other"
      ]
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "authority_floor", "freshness_required", "acceptance_rule"],
      "properties": {
        "required": { "type": "boolean" },
        "authority_floor": {
          "enum": [
            "A_OFFICIAL_PRIMARY",
            "A_SCHOLARLY_PRIMARY",
            "B_SCHOLARLY_SYNTHESIS",
            "B_TRUSTED_METADATA",
            "C_DISCOVERY_ONLY",
            "U_UNVERIFIED"
          ]
        },
        "freshness_required": { "type": "boolean" },
        "acceptance_rule": { "type": "string", "minLength": 1 }
      }
    },
    "planned_capability_id": { "type": "string", "minLength": 1 },
    "actual_route": {
      "enum": [
        "browser",
        "api",
        "academic_database",
        "pdf_reader",
        "reference_manager",
        "consensus_browser",
        "consensus_api",
        "scite_browser",
        "scite_api",
        "user_assisted",
        "manual_local",
        "not_executed",
        "other"
      ]
    },
    "query_or_action": {
      "type": ["string", "null"]
    },
    "executed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": { "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" }
    },
    "trace_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fallback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["used", "route", "limitations"],
      "properties": {
        "used": { "type": "boolean" },
        "route": { "type": ["string", "null"] },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "actual_route": { "not": { "const": "not_executed" } },
          "query_or_action": { "type": "string", "minLength": 1 },
          "executed_at": { "type": "string", "format": "date-time" },
          "source_ids": { "minItems": 1 },
          "trace_refs": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "NOT_CHECKED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "source_ids": { "maxItems": 0 }
        }
      }
    }
  ]
}
